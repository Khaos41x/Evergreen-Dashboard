# Public, low-privilege project configuration. Never use service_role or sb_secret.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Server-only. Exact HTTPS origin in production; loopback HTTP only in development.
APP_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Enable only after real provider/domain validation.
GOOGLE_AUTH_ENABLED=false
PASSKEY_AUTH_ENABLED=false
# Production requires shared Redis REST with EVAL support. Never prefix with VITE_.
REDIS_REST_URL=
REDIS_REST_TOKEN=
