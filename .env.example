# Public, low-privilege project configuration. Never use service_role or sb_secret.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Server-only. Exact HTTPS origin in production; loopback HTTP only in development.
APP_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Enable only after real provider/domain validation.
GOOGLE_AUTH_ENABLED=false
PASSKEY_AUTH_ENABLED=false
# Production requires the real DB limiter proof OR shared Redis REST with EVAL. Never VITE_.
RATE_LIMIT_PROOF=
REDIS_REST_URL=
REDIS_REST_TOKEN=
# Server-only integration encryption: 32 random bytes in base64. Never VITE_.
INTEGRATIONS_ENCRYPTION_KEY=
INTEGRATIONS_STORAGE_SERVICE_KEY=

# Server only, at least 32 random characters; optional scheduler bearer authentication.
CRON_SECRET=

# Native callback support; requires backend deployment + Supabase redirect allowlist.
NATIVE_AUTH_ENABLED=false
# Push is disabled until migration, provider credentials, app capabilities and scheduler exist.
NATIVE_PUSH_ENABLED=false
NATIVE_PUSH_SERVICE_KEY=
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=sandbox

# Optional outside Vercel: development, staging, production. Never a VITE_ variable.
# AUTH_ENVIRONMENT=development
# Hosted APP_ORIGIN must be the exact public HTTPS origin; no path or trailing slash.
# Supabase hosted Site URL/Redirect URLs/templates are managed separately; see docs/AUTH-P0-20261101.md.
