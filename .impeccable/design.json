      "description": "Ação geral de formulário; o composer possui variante compacta.",
      "html": "<button class=\"ds-primary\">Salvar alterações</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:9px 14px;border:1px solid var(--emerald,#10d994);border-radius:8px;background:var(--emerald,#10d994);color:#04150f;font:650 14px/1.35 Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;cursor:pointer;transition:background-color .15s,border-color .15s,color .15s}.ds-primary:hover:not(:disabled){background:#36e7ac}.ds-primary:focus-visible{outline:2px solid var(--emerald,#10d994);outline-offset:3px}.ds-primary:disabled{background:#1b3026;border-color:#354d40;color:#b4c4bb;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
