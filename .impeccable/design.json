      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:9px 14px;border:1px solid var(--line,#1b2320);border-radius:8px;background:var(--raised,#0d1312);color:var(--text,#f3f4f2);font:500 14px/1.35 Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;cursor:pointer;transition:background-color .15s,border-color .15s,color .15s}.ds-secondary:hover{background:var(--hover,#111917)}.ds-secondary:focus-visible{outline:2px solid var(--emerald,#10d994);outline-offset:3px}.ds-secondary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
