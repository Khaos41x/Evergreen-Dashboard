      "css": ".ds-label{display:grid;gap:7px;margin:12px 0;color:var(--soft,#bdc7c3);font:14px/1.5 Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-field{width:100%;min-height:44px;padding:10px 12px;border:1px solid #35423d;border-radius:8px;background:var(--bg,#070a09);color:var(--text,#f3f4f2);font:16px Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;caret-color:var(--emerald,#10d994)}.ds-field::placeholder{color:#9ba9a2}.ds-field:focus-visible{outline:2px solid var(--emerald,#10d994);outline-offset:3px}"
    },
