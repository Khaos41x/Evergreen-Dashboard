{
  "name": "evergreen-tasks",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/auth-config-check.mjs && tsc -b && vite build && node scripts/mobile-ota.mjs",
    "preview": "vite preview",
    "test:security": "node scripts/security-check.mjs",
    "test:mobile": "node scripts/mobile-check.mjs",
    "test:local": "node scripts/functional-check.mjs",
    "test:collaboration-ui": "node scripts/collaboration-ui-check.mjs",
    "test:e2e:real": "node scripts/e2e-real.mjs",
    "test:preservation": "node scripts/local-preservation-check.mjs",
    "test:world:model": "node --experimental-strip-types scripts/world-model-check.mjs",
    "test:world": "node scripts/world-check.mjs",
    "test:platform:security": "node scripts/platform-security-check.mjs",
    "test:identity": "node scripts/identity-check.mjs",
    "test:auth:p0": "node scripts/auth-p0-check.mjs",
    "test:auth:ui": "node scripts/auth-p0-browser-check.mjs",
    "test:email-template": "node scripts/email-template-check.mjs",
    "test:platform:ui": "node scripts/platform-browser-check.mjs",
    "test:local:regression": "node scripts/local-regression-check.mjs",
    "test:platform:release": "node scripts/platform-security-check.mjs --release",
    "test:holding:providers": "node scripts/integration-check.mjs",
    "test:holding:model": "node --experimental-strip-types scripts/holding-model-check.mjs",
    "test:holding:ui": "node scripts/holding-browser-check.mjs",
    "test:holding:receipts": "node scripts/receipt-browser-check.mjs",
    "test:organization:ui": "node scripts/organization-browser-check.mjs",
    "test:os:ui": "node scripts/os-browser-check.mjs",
    "test:library:ui": "node scripts/library-browser-check.mjs",
    "mobile:sync": "npm run build && cap sync && node scripts/native-hardening.mjs",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "mobile:doctor": "node scripts/mobile-doctor.mjs",
    "mobile:apk": "node scripts/mobile-apk.mjs",
    "test:mobile:bridge": "node scripts/native-check.mjs",
    "test:mobile:ui": "node scripts/native-browser-check.mjs",
    "mobile:assets": "capacitor-assets generate --android --ios --assetPath resources --iconBackgroundColor \"#f3f4f2\" --iconBackgroundColorDark \"#f3f4f2\" --splashBackgroundColor \"#f3f4f2\" --splashBackgroundColorDark \"#f3f4f2\"",
    "mobile:release": "node scripts/mobile-release.mjs",
    "test:mobile:updates": "node scripts/mobile-update-check.mjs",
    "test:mobile:updates:ui": "node scripts/mobile-update-browser-check.mjs",
    "test:mobile:release": "node scripts/mobile-release-check.mjs",
    "test:mobile:ota": "node scripts/mobile-ota-check.mjs",
    "test:auth:scroll": "node scripts/auth-scroll-check.mjs",
    "test:profiles:refresh": "node scripts/avatar-refresh-check.mjs",
    "test:holding:connection-ui": "node scripts/integration-flow-browser-check.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/push-notifications": "8.1.3",
    "@capgo/capacitor-updater": "8.54.0",
    "@react-three/fiber": "9.8.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@vitejs/plugin-react": "latest",
    "cookie": "2.0.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "0.186.1",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0",
    "@electric-sql/pglite": "0.5.12",
    "@types/node": "22.18.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "0.186.0",
    "autoprefixer": "latest",
    "fflate": "0.8.3",
    "playwright-core": "^1.64.0",
    "postcss": "latest",
    "tailwindcss": "^3.4.17",
    "typescript": "latest"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3",
    "uuid": "11.1.1"
  }
}
